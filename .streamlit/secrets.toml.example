# OPSIONAL — aplikasi berjalan penuh tanpa berkas ini.
#
# Voice-to-text sudah aktif tanpa API key (Google Speech Recognition gratis).
# Kedua isian di bawah hanya menambah kemampuan.
#
# PENTING: kedua API ini TERPISAH di Google Cloud. Satu key tidak otomatis
# berlaku untuk keduanya — masing-masing harus diaktifkan tersendiri di
# Google Cloud Console.
#
# Salin berkas ini menjadi secrets.toml lalu isi.
# JANGAN commit secrets.toml ke git.

# Terjemahan ke bahasa Indonesia (aktifkan "Cloud Translation API").
# Berguna bila catatan sebagian ditulis dalam bahasa Inggris — kriteria
# SDKI berbahasa Indonesia, jadi teks Inggris tidak akan cocok.
# GOOGLE_TRANSLATE_API_KEY = "isi-api-key-translate-anda"

# Transkripsi yang lebih akurat untuk istilah klinis, berbayar
# (aktifkan "Cloud Speech-to-Text API").
# GOOGLE_STT_API_KEY = "isi-api-key-speech-anda"
