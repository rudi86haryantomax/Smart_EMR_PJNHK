# Voice-to-text berjalan TANPA API key memakai Google Speech Recognition
# gratis. Isian di bawah OPSIONAL — hanya bila ingin memakai Google Cloud
# Speech-to-Text yang berbayar, dengan akurasi istilah klinis lebih baik.
#
# PENTING: API key Google tidak berlaku lintas layanan. Key untuk Google
# Translate TIDAK bisa dipakai di sini; aktifkan dulu "Cloud Speech-to-Text
# API" untuk key tersebut di Google Cloud Console.
GOOGLE_STT_API_KEY=

# API key Google Translate (OPSIONAL) — memunculkan tombol "Terjemahkan
# ke Indonesia" pada kolom S dan O. Berguna karena kriteria SDKI
# berbahasa Indonesia: bagian catatan berbahasa Inggris tidak akan cocok
# sebelum diterjemahkan.
# Aktifkan "Cloud Translation API" untuk key ini di Google Cloud Console.
GOOGLE_TRANSLATE_API_KEY=

# Bahasa transkripsi
ASUHAN_STT_LANG=id-ID

# Lokasi database SQLite (opsional; default: data/asuhan.db)
# ASUHAN_DB_PATH=/path/ke/asuhan.db

# Master 3S alternatif (opsional; default: data/sdki_slki_siki.json)
# ASUHAN_SDKI_JSON=/path/ke/sdki.json

# Mode pemakaian: 'pembelajaran' (bawaan) atau 'klinis'.
# Mode klinis menaikkan nada peringatan soal penyimpanan & kerahasiaan.
# ASUHAN_MODE=pembelajaran

# Override deteksi lingkungan bila diperlukan
# ASUHAN_PENYIMPANAN=permanen
# ASUHAN_AKSES=privat
